# NordRouter API key
NORDROUTER_API_KEY=sk-your-api-key-here

# NordRouter base URL
NORDROUTER_BASE_URL=https://nordrouter.net/v1

# Optional: timeout in seconds for API calls (generation can be slow, keep it high)
NORDROUTER_TIMEOUT=180

# Optional: root directory used to resolve relative image paths.
# Defaults to the process working directory.
# Set it to a common parent (e.g. ~/Documents/aiDev) so relative paths like
# "my-project/public/images/hero.png" resolve from any project under it.
NORDROUTER_PROJECT_ROOT=/Users/evmelnik/Documents/aiDev

# Gateway safety filter. It is ON by default on the server side; keep it off so
# the gateway does not reject prompts. Set to "true" only if you want moderation.
NORDROUTER_SAFETY_FILTER=false
